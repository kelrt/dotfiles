# ~/.config/sway/window_rules

# Native Wayland Thunar
for_window [app_id="Thunar" title=".*Progress.*"] floating enable
for_window [app_id="thunar" title=".*Progress.*"] floating enable
for_window [app_id="Thunar" title=".*Confirm.*"] floating enable
for_window [app_id="thunar" title=".*Confirm.*"] floating enable
for_window [app_id="Thunar" title=".*Rename.*"] floating enable
for_window [app_id="thunar" title=".*Rename.*"] floating enable

# XWayland Thunar (fallback)
for_window [class="Thunar" title=".*Progress.*"] floating enable
for_window [class="Thunar" title=".*Rename.*"] floating enable

# Catch generic pop-ups and dialogs
for_window [window_role="pop-up"] floating enable
for_window [window_role="dialog"] floating enable
for_window [window_type="dialog"] floating enable


# --- scratchpad apps ---
#for_window [class="bitwarden"]  mark bw,   floating enable, resize set 900 650, move scratchpad
#for_window [app_id="todoist"]   mark todo, floating enable, resize set 1000 700, move scratchpad
for_window [app_id="calcpad"]   mark calc, floating enable, resize set 450 550, move scratchpad

# autolaunch
exec flatpak run com.bitwarden.desktop
exec flatpak run com.todoist.Todoist
exec $HOME/.cargo/bin/parse

# keys
bindsym $mod+p [con_mark="calc"] scratchpad show