# ~/.config/sway/window_rules

# Native Wayland Thunar
for_window [app_id="Thunar" title=".*Progress.*"] floating enable
for_window [app_id="thunar" title=".*Progress.*"] floating enable
for_window [app_id="Thunar" title=".*Confirm.*"] floating enable
for_window [app_id="thunar" title=".*Confirm.*"] floating enable
for_window [app_id="Thunar" title=".*Rename.*"] floating enable
for_window [app_id="thunar" title=".*Rename.*"] floating enable

# XWayland Thunar (fallback)
for_window [class="Thunar" title=".*Progress.*"] floating enable
for_window [class="Thunar" title=".*Rename.*"] floating enable

# Catch generic pop-ups and dialogs
for_window [window_role="pop-up"] floating enable
for_window [window_role="dialog"] floating enable
for_window [window_type="dialog"] floating enable



# Translucent Windows 
for_window [app_id=com.microsoft.VSCode] opacity 0.97


# --- scratchpad apps ---
for_window [class="bitwarden"]  mark bw,   floating enable, resize set 1350 950, move scratchpad
#for_window [app_id="todoist"]   mark todo, floating enable, resize set 1000 700, move scratchpad
for_window [app_id="calcpad"]   mark calc, floating enable, resize set 450 550, move scratchpad
# tiling: only a newly opened window matches. After each reload sway runs these rules again at
# a window's next title change, and typing or saving changes Mousepad's, which hid the notes.
for_window [app_id="mousepad" title="notes\.txt" tiling] mark notes, floating enable, resize set 650 600, move scratchpad

# autolaunch
exec flatpak run com.bitwarden.desktop
exec flatpak run com.todoist.Todoist
exec $HOME/.cargo/bin/parse
exec python3 ~/.config/sway/scripts/inactive-windows-transparency.py -o 0.96 -g
exec python3 ~/.config/sway/scripts/autotiling.py
exec mousepad /home/relz/Documents/notes.txt


# keys: show or hide, and start the app first if it isn't running (after a crash, say)
bindsym $mod+c exec ~/.config/sway/scripts/scratch-app calc
bindsym $mod+n exec ~/.config/sway/scripts/scratch-app notes
bindsym $mod+b exec ~/.config/sway/scripts/scratch-app bw
