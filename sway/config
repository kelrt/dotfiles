### --- VARIABLES ---
set $mod Mod4
set $win Mod1
floating_modifier $mod normal
set $left h
set $down j
set $up k
set $right l
set $term foot
set $menu ~/.config/wofi/menu --show drun --sort-order alphabetical

# Import the session environment and start graphical-session.target first
exec /usr/libexec/sway-systemd/session.sh

include includes/*

default_border pixel 1
default_floating_border pixel 1
smart_gaps on

### --- OUTPUT CON=+FIGURATION (MONITORS & WALLPAPER) ---
# The wallpaper pickers point this link at each new pick, so login shows the picture the bar's
# colours came from (waybar/scripts/wal_picker.sh and random_wall.sh). If the link is ever
# missing, the colour at the end is used instead of an error at login.
output * bg /home/relz/.config/sway/wallpaper fill #202020

output HDMI-A-1 {
    # 60 Hz gives this monitor (Gigabyte M27Q X) horizontal lines; 120 Hz is clean.
    mode  2560x1440@120Hz
    pos 1920 0
    adaptive_sync off
    max_render_time 5
}

output eDP-1 {
    mode 1920x1200@60Hz
    pos 0 0
    adaptive_sync off
    max_render_time 10
    scale 1
    scale_filter linear
}


## --- INPUT CONFIGURATION ---
input type:pointer {
   accel_profile flat
}

input type:keyboard {
    xkb_layout "us"
}

# The laptop's own keyboard: Caps Lock and Ctrl swapped, Alt and Super swapped, to match the HHKB.
# Only this keyboard gets them, so the HHKB stays as it is and both work at the same time.
input 1:1:AT_Translated_Set_2_keyboard {
    xkb_options "ctrl:swapcaps,altwin:swap_alt_win"
}


### --- STATUS BAR ---
# reveal.py starts waybar and opens and closes it. swaybar_command can't take arguments, so this is
# a plain exec. The previous bar is in ~/.config/waybar/lab/old.
exec python3 ~/.config/waybar/reveal.py waybar -c ~/.config/waybar/config.jsonc -s ~/.config/waybar/style.css

### --- IDLE MANAGEMENT ---
exec swayidle -w \
    timeout 300 'pidof hyprlock || hyprlock &' \
    timeout 330 'swaymsg "output * dpms off"' \
    resume 'swaymsg "output * dpms on"' \
    timeout 500 'systemctl suspend' \
    before-sleep 'pidof hyprlock || { hyprlock & sleep 1; }'

    

exec nm-applet --indicator
exec ~/.cargo/bin/mprisence
exec fcitx5 -d
exec sleep 2 && blueman-applet
exec /usr/libexec/lxqt-policykit-agent
exec sh ~/.config/sway/scripts/low-battery.sh
exec python3 ~/.config/waybar/lab/osd/osd.py

# --- Custom Overrides ---
# Remove the top gap globally, overriding any included system defaults
gaps top 0

# Remove the 1-pixel Sway border specifically for Firefox so the mouse hits the browser UI
for_window [app_id="firefox"] border none
