### --- VARIABLES ---
set $mod Mod4
set $win Mod1
floating_modifier $mod normal
set $left h
set $down j
set $up k
set $right l
set $term foot
set $menu wofi --show drun

include includes/*


default_border pixel 1
default_floating_border pixel 1
smart_gaps on

### --- OUTPUT CON=+FIGURATION (MONITORS & WALLPAPER) ---
output * bg /home/relz/Pictures/wallpapers/clouds.png fill

output HDMI-A-1 {
    mode  2560x1440@60Hz
    pos 1920 0
    adaptive_sync off
}

output eDP-1 {
    mode 1920x1200@60Hz
    pos 0 0
    adaptive_sync off
    scale 1
    scale_filter linear
}


## --- INPUT CONFIGURATION ---
input type:pointer {
   accel_profile flat
}

input type:keyboard {
    xkb_layout "us"
    xkb_options "ctrl:swapcaps,altwin:swap_alt_win"
}


### --- STATUS BAR ---
bar {
    swaybar_command waybar
}

### --- IDLE MANAGEMENT ---
exec swayidle -w \
    timeout 300 'pidof hyprlock || hyprlock &' \
    timeout 330 'swaymsg "output * dpms off"' \
    resume 'swaymsg "output * dpms on"' \
    timeout 500 'systemctl suspend' \
    before-sleep 'pidof hyprlock || hyprlock'

    

exec nm-applet --indicator
exec ~/.cargo/bin/mprisence
exec fcitx5 -d

# --- Custom Overrides ---
# Remove the top gap globally, overriding any included system defaults
gaps top 0

# Remove the 1-pixel Sway border specifically for Firefox so the mouse hits the browser UI
for_window [app_id="firefox"] border none
